# Copy to .env.local (not committed) and fill in. Restart `npm run dev` after changes.

# Mock API (json-server)
VITE_API_URL=http://localhost:3001

# Google Maps JavaScript API browser key. In Google Cloud, enable "Maps JavaScript API",
# link a billing account, and restrict the key to your app's URLs (HTTP referrers).
VITE_GOOGLE_MAPS_API_KEY=

# Optional Map ID (Google Cloud > Map management). Its cloud map style controls the look;
# without it Google's DEMO_MAP_ID is used, which is fine for development.
VITE_GOOGLE_MAPS_MAP_ID="AIzaSyCPhkUMtAund6Uk1acTFWLsUt5A4Ir9zDU"
